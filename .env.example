# Laufzeit
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200

# Access Keypair (RS256) – leer lassen, wird bei init erzeugt
JWT_ACCESS_PRIVATE_KEY_PEM=
JWT_ACCESS_PUBLIC_KEY_PEM=

# Refresh Keypair (RS256) – leer lassen, wird bei init erzeugt
JWT_REFRESH_PRIVATE_KEY_PEM=
JWT_REFRESH_PUBLIC_KEY_PEM=

# Token-Laufzeiten
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

MIGRATION_BACKUP_DB=tobu_finance_backups
