{
  "name": "tobu-finance-api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "migrate": "ts-node src/migrate.ts up",
    "migrate:up": "ts-node src/migrate.ts up",
    "migrate:down": "ts-node src/migrate.ts down",
    "migrate:pending": "ts-node src/migrate.ts pending",
    "migrate:list": "ts-node src/migrate.ts list",
    "migrate:create": "ts-node scripts/new-migration.ts",
    "build": "tsc -p .",
    "start": "NODE_ENV=production node dist/server.js",
    "seed": "ts-node-dev --transpile-only scripts/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "mongodb": "^6.18.0",
    "mongoose": "^8.17.1",
    "morgan": "^1.10.1",
    "umzug": "^3.8.2",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.2.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  }
}
